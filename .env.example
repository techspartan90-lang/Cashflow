# ==============================================================================
# CashFlow Intelligence — Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env.local for local development.
# NEVER commit real credentials, service-role keys, or JWT secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (Phase 2 & Phase 8)
# ------------------------------------------------------------------------------
# Public Supabase URL (safe for frontend client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anon Key (safe for browser client with RLS enabled)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# SUPABASE SERVICE ROLE KEY (CRITICAL: SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Bypasses RLS for administrative jobs and secure server-to-server operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Direct Postgres connection string for running migrations (Optional)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AI MICROSERVICE & FASTAPI INTEGRATION (Phase 5)
# ------------------------------------------------------------------------------
# Target URL of the Python FastAPI prediction microservice
FASTAPI_AI_URL=http://localhost:8000

# Python FastAPI environment mode
APP_ENV=development

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION (Phase 5 Deep Advisory)
# ------------------------------------------------------------------------------
# Set automatically in Google Cloud / AI Studio preview environment
# GEMINI_API_KEY=your-gemini-api-key-placeholder

# ------------------------------------------------------------------------------
# 5. SECURITY & RATE LIMITING CONTROLS (Phase 8)
# ------------------------------------------------------------------------------
# Maximum requests allowed per 60-second sliding window per IP
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_MS=60000

# Strict CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 6. LOGGING & OBSERVABILITY (Phase 8)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_DETAILED_AUDIT_LOGS=true
